{
  "name": "cyneform-monorepo",
  "version": "1.0.0",
  "private": true,
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "catalog": {
      "zod": "^4.6.7"
    }
  },
  "scripts": {
    "dev": "bun run --filter './apps/*' --parallel dev",
    "start": "bun run --filter './apps/*' --parallel start",
    "build": "bun run --filter './apps/*' --parallel build",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "typecheck": "bun run --filter './apps/*' --filter './packages/*' typecheck",
    "test": "bun run --filter './apps/*' test",
    "db:up": "docker compose up -d mariadb",
    "db:down": "docker compose down",
    "db:generate": "bun --cwd packages/db db:generate",
    "db:push": "bun --cwd packages/db db:push",
    "db:migrate": "bun --cwd packages/db db:migrate",
    "db:studio": "bun --cwd packages/db db:studio",
    "db:seed": "bun apps/api/src/database/seed.ts",
    "dev:worker": "bun --cwd apps/worker dev",
    "prepare": "lefthook install"
  },
  "engines": {
    "bun": ">=1.3.14",
    "node": ">=22"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.1",
    "@types/node": "^24.0.0",
    "lefthook": "^2.2.2",
    "typescript": "~5.9.3"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.4",
    "jose": "^6.2.15"
  }
}
