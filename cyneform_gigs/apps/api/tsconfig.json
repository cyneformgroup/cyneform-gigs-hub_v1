{
  "compilerOptions": {
    "target": "es2022",
    "module": "esnext",
    "moduleResolution": "bundler",
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "strictPropertyInitialization": false,
    "skipLibCheck": true,
    "noEmit": true,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "types": ["node", "vitest/globals"],
    "paths": {
      "@cyneform/db": ["./packages/db/src"],
      "@cyneform/types": ["./packages/types/src"],
      "@cyneform/validators": ["./packages/validators/src"]
    }
  },
  "include": ["src/**/*", "test/**/*", "vitest.config.ts", "vitest.config.e2e.ts"]
}
